// Cloudflare Workers config: serves the static Astro build from dist/.
// Unused until the repo is imported into Cloudflare — see "Moving to
// Cloudflare" in the README. GitHub Pages ignores this file.
{
  "name": "the-makers-clay",
  "compatibility_date": "2026-09-01",
  "assets": {
    "directory": "./dist",
    // Unknown paths get /404.html, the same as GitHub Pages does.
    "not_found_handling": "404-page"
  }
}
