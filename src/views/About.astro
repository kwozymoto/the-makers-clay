---
import Waitlist from '../components/Waitlist.astro';
import PieceImage from '../components/PieceImage.astro';
import about from '../data/about.json';
import { SITE } from '../config';
import type { Lang } from '../i18n/ui';
import { useTranslations, localePath } from '../i18n/utils';

interface Props {
  lang: Lang;
}

const { lang } = Astro.props;
const t = useTranslations(lang);
const p = (path: string) => localePath(lang, path);

/* Swap these for photos of you and the studio — drop files in src/assets/pieces/. */
const portrait = 'studio-2.jpg';
const studioStrip = ['studio-3.jpg', 'studio-1.jpg', 'cat-friends-2.jpg'];

/* The story is in src/data/about.json so it can be edited in Pages CMS
   without touching code. */
const { heading, paragraphs } = about[lang];
---

<section class="section section--tight">
  <div class="wrap layout">
    <div class="copy">
      <p class="eyebrow">{t('about.title')}</p>
      <h1>{heading}</h1>
      <div class="prose">
        {paragraphs.map((text) => <p>{text}</p>)}
      </div>
      <div class="cta">
        <a class="btn btn--primary" href={p('/shop')}>{t('nav.shop')}</a>
        <a class="btn btn--ghost" href={SITE.instagram} rel="me noopener" target="_blank">
          {SITE.instagramHandle}
        </a>
      </div>
    </div>

    <div class="portrait">
      <PieceImage
        name={portrait}
        alt={lang === 'zh' ? '工作室一角' : 'The studio'}
        ratio="4 / 5"
        sizes="(max-width: 900px) 100vw, 420px"
      />
    </div>
  </div>
</section>

<section class="section section--tight strip-section">
  <div class="wrap">
    <p class="eyebrow">{lang === 'zh' ? '工作室日常' : 'From the studio'}</p>
    <div class="strip">
      {
        studioStrip.map((name) => (
          <PieceImage
            name={name}
            alt={lang === 'zh' ? '工作室日常' : 'From the studio'}
            ratio="1 / 1"
            sizes="(max-width: 700px) 45vw, 340px"
            widths={[320, 560, 720]}
          />
        ))
      }
    </div>
  </div>
</section>

<Waitlist lang={lang} />

<style>
  .layout {
    display: grid;
    grid-template-columns: 1.15fr 0.85fr;
    gap: clamp(2rem, 5vw, 4rem);
    align-items: start;
  }

  h1 { margin-bottom: 0.6em; }

  .cta {
    display: flex;
    gap: 0.75rem;
    flex-wrap: wrap;
    margin-top: 2rem;
  }

  .portrait {
    border-radius: var(--r-md);
    box-shadow: var(--shadow-md);
    rotate: 1.5deg;
  }

  .strip-section { border-top: 1px solid var(--line); }

  .strip {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: clamp(0.75rem, 2vw, 1.25rem);
  }

  @media (max-width: 900px) {
    .layout { grid-template-columns: 1fr; }
    .portrait { order: -1; max-width: 420px; rotate: 0deg; }
  }
</style>
