---
import '@fontsource-variable/fraunces/full.css';
import '../styles/global.css';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import { SITE } from '../config';
import type { Lang } from '../i18n/ui';
import { altLangPath } from '../i18n/utils';

interface Props {
  lang: Lang;
  title: string;
  description?: string;
}

const { lang, title, description = '' } = Astro.props;

const htmlLang = lang === 'zh' ? 'zh-Hans' : 'en';
const siteName = lang === 'zh' ? SITE.nameZh + ' The Makers Clay' : SITE.name;
const fullTitle = title ? title + ' · ' + SITE.name : SITE.name;

const canonical = new URL(Astro.url.pathname, Astro.site ?? Astro.url.origin);
const altPath = altLangPath(lang, Astro.url.pathname);
const altHref = new URL(altPath, Astro.site ?? Astro.url.origin);
const enHref = new URL(lang === 'en' ? Astro.url.pathname : altPath, Astro.site ?? Astro.url.origin);
const zhHref = new URL(lang === 'zh' ? Astro.url.pathname : altPath, Astro.site ?? Astro.url.origin);
---

<!doctype html>
<html lang={htmlLang}>
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{fullTitle}</title>
    {description && <meta name="description" content={description} />}
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="canonical" href={canonical.href} />
    <link rel="alternate" hreflang="en" href={enHref.href} />
    <link rel="alternate" hreflang="zh-Hans" href={zhHref.href} />
    <link rel="alternate" hreflang="x-default" href={enHref.href} />

    <meta property="og:type" content="website" />
    <meta property="og:site_name" content={siteName} />
    <meta property="og:title" content={fullTitle} />
    {description && <meta property="og:description" content={description} />}
    <meta property="og:url" content={canonical.href} />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="theme-color" content="#fbf8f3" />
    <slot name="head" />
  </head>
  <body lang={htmlLang}>
    <a class="skip" href="#main">Skip to content</a>
    <Header lang={lang} altHref={altHref.pathname} />
    <main id="main">
      <slot />
    </main>
    <Footer lang={lang} />
  </body>
</html>

<style>
  .skip {
    position: absolute;
    left: -9999px;
    top: 0;
    z-index: 100;
    background: var(--ink);
    color: var(--paper);
    padding: 0.75rem 1.25rem;
    border-radius: 0 0 var(--r-sm) 0;
    text-decoration: none;
  }
  .skip:focus {
    left: 0;
  }
</style>
