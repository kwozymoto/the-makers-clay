---
import { Image } from 'astro:assets';
import { resolveImage } from '../lib/pieces';

interface Props {
  name?: string;
  alt: string;
  sizes?: string;
  widths?: number[];
  eager?: boolean;
  /** CSS aspect-ratio for the frame, e.g. '4 / 5'. */
  ratio?: string;
}

const {
  name,
  alt,
  sizes = '(max-width: 640px) 100vw, (max-width: 1100px) 45vw, 360px',
  widths = [320, 480, 720, 1080],
  eager = false,
  ratio = '4 / 5',
} = Astro.props;

const img = await resolveImage(name);
---

<div class="frame" style={`aspect-ratio: ${ratio}`}>
  {
    img ? (
      <Image
        src={img}
        alt={alt}
        widths={widths}
        sizes={sizes}
        loading={eager ? 'eager' : 'lazy'}
        decoding={eager ? 'sync' : 'async'}
        format="webp"
        quality={82}
      />
    ) : (
      <div class="ph" role="img" aria-label={alt}>
        <svg viewBox="0 0 120 120" aria-hidden="true" focusable="false">
          <path
            d="M42 34c0-4 3-6 18-6s18 2 18 6c0 3-2 4-4 6 10 6 16 15 16 26 0 15-13 26-30 26S30 81 30 66c0-11 6-20 16-26-2-2-4-3-4-6z"
            fill="none"
            stroke="currentColor"
            stroke-width="2.5"
            stroke-linejoin="round"
          />
          <path d="M52 62c1.5 2 3 2 4.5 0M63.5 62c1.5 2 3 2 4.5 0" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" />
        </svg>
      </div>
    )
  }
</div>

<style>
  .frame {
    position: relative;
    width: 100%;
    overflow: hidden;
    border-radius: var(--r-md);
    background: var(--paper-2);
  }

  .frame :global(img) {
    width: 100%;
    height: 100%;
    object-fit: cover;
    display: block;
    transition: transform 0.5s cubic-bezier(0.2, 0.6, 0.2, 1);
  }

  .ph {
    position: absolute;
    inset: 0;
    display: grid;
    place-items: center;
    background:
      radial-gradient(120% 90% at 50% 0%, #fff 0%, transparent 60%),
      linear-gradient(165deg, var(--paper-2), var(--clay-soft));
    color: var(--clay);
    opacity: 0.85;
  }

  .ph svg {
    width: 44%;
    max-width: 110px;
    height: auto;
    opacity: 0.55;
  }
</style>
